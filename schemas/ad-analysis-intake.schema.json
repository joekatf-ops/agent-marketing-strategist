{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestylebrands.example/schemas/ad-analysis-intake.schema.json",
  "title": "Ad analysis intake",
  "$comment": "This standard JSON Schema governs structural shape. Portable validation is complete only when a runtime also asserts the date and iana-timezone formats and applies every rule in ad-analysis-intake.conformance.json. The deterministic loader additionally rejects duplicate JSON keys, non-finite numbers, inputs over 1048576 bytes, nesting deeper than 32 containers, credentials, and unsafe local file sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "brand_slug",
    "method_version",
    "market",
    "product_id",
    "account_timezone",
    "requester",
    "requested_at",
    "ads",
    "sources",
    "performance",
    "known_limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^ADR-\\d{8}-\\d{3}$"},
    "mode": {"enum": ["creative-audit", "performance-diagnosis"]},
    "brand_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "method_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "market": {"$ref": "#/$defs/requiredText"},
    "product_id": {"$ref": "#/$defs/requiredText"},
    "account_timezone": {"$ref": "#/$defs/singleLineText"},
    "requester": {"$ref": "#/$defs/singleLineText"},
    "requested_at": {"type": "string", "format": "date"},
    "ads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ad"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "performance": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/performance"}
      ]
    },
    "known_limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/requiredText"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "performance-diagnosis"}},
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "account_timezone": {
            "type": "string",
            "minLength": 1,
            "format": "iana-timezone"
          },
          "performance": {"$ref": "#/$defs/performanceDiagnosis"}
        }
      }
    }
  ],
  "$defs": {
    "requiredText": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\r\\n])\\S(?:[^\\r\\n]*\\S)?$"
    },
    "singleLineText": {
      "type": "string",
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?:|\\S(?:[^\\r\\n]*\\S)?)$"
    },
    "nullableText": {
      "type": ["string", "null"],
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?:|\\S(?:[^\\r\\n]*\\S)?)$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "label", "location", "sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/requiredText"},
        "kind": {"enum": ["file", "attachment", "url", "screenshot", "table"]},
        "label": {"$ref": "#/$defs/requiredText"},
        "location": {"$ref": "#/$defs/requiredText"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "ad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ad_id",
        "asset_source_ids",
        "asset_type",
        "primary_text",
        "headline",
        "description",
        "cta",
        "destination_url",
        "destination_type",
        "coordinate_key",
        "contst",
        "source",
        "who",
        "primary_problem",
        "awareness_code",
        "messaging_route",
        "format",
        "primary_hook",
        "post_id"
      ],
      "properties": {
        "ad_id": {"$ref": "#/$defs/requiredText"},
        "asset_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requiredText"}
        },
        "asset_type": {"enum": ["video", "static", "carousel", "other", null]},
        "primary_text": {"$ref": "#/$defs/nullableText"},
        "headline": {"$ref": "#/$defs/nullableText"},
        "description": {"$ref": "#/$defs/nullableText"},
        "cta": {"$ref": "#/$defs/nullableText"},
        "destination_url": {"$ref": "#/$defs/nullableText"},
        "destination_type": {"enum": ["LP", "PDP", "HP", "CP", null]},
        "coordinate_key": {"$ref": "#/$defs/nullableText"},
        "contst": {"type": ["string", "null"], "pattern": "^CONTST\\d{3}$"},
        "source": {"enum": ["NNT", "INSPO", "ITR", null]},
        "who": {"$ref": "#/$defs/nullableText"},
        "primary_problem": {"$ref": "#/$defs/nullableText"},
        "awareness_code": {"enum": ["UWA", "PRA", "SLA", "PDA", null]},
        "messaging_route": {"$ref": "#/$defs/nullableText"},
        "format": {"$ref": "#/$defs/nullableText"},
        "primary_hook": {"$ref": "#/$defs/nullableText"},
        "post_id": {"$ref": "#/$defs/nullableText"}
      }
    },
    "dateRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "fieldMapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ad_id": {"$ref": "#/$defs/requiredText"},
        "spend": {"$ref": "#/$defs/requiredText"},
        "purchases": {"$ref": "#/$defs/requiredText"},
        "impressions": {"$ref": "#/$defs/requiredText"},
        "reach": {"$ref": "#/$defs/requiredText"},
        "frequency": {"$ref": "#/$defs/requiredText"},
        "cpm": {"$ref": "#/$defs/requiredText"},
        "link_clicks": {"$ref": "#/$defs/requiredText"},
        "outbound_clicks": {"$ref": "#/$defs/requiredText"},
        "landing_page_views": {"$ref": "#/$defs/requiredText"},
        "ctr": {"$ref": "#/$defs/requiredText"},
        "cpc": {"$ref": "#/$defs/requiredText"},
        "adds_to_cart": {"$ref": "#/$defs/requiredText"},
        "initiates_checkout": {"$ref": "#/$defs/requiredText"},
        "checkouts": {"$ref": "#/$defs/requiredText"},
        "purchase_value": {"$ref": "#/$defs/requiredText"},
        "roas": {"$ref": "#/$defs/requiredText"},
        "video_3_second_plays": {"$ref": "#/$defs/requiredText"},
        "video_thruplays": {"$ref": "#/$defs/requiredText"},
        "video_plays_at_25_percent": {"$ref": "#/$defs/requiredText"},
        "video_plays_at_50_percent": {"$ref": "#/$defs/requiredText"},
        "video_plays_at_75_percent": {"$ref": "#/$defs/requiredText"},
        "video_plays_at_95_percent": {"$ref": "#/$defs/requiredText"},
        "video_plays_at_100_percent": {"$ref": "#/$defs/requiredText"},
        "average_video_play_time": {"$ref": "#/$defs/requiredText"}
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurred_at", "scope", "description", "ad_id"],
      "properties": {
        "occurred_at": {"$ref": "#/$defs/requiredText"},
        "scope": {"enum": ["account", "campaign", "ad-set", "ad"]},
        "description": {"$ref": "#/$defs/requiredText"},
        "ad_id": {"$ref": "#/$defs/nullableText"}
      }
    },
    "accountNorm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "comparison_window", "source"],
      "properties": {
        "metric": {"$ref": "#/$defs/requiredText"},
        "value": {"type": "number"},
        "unit": {"$ref": "#/$defs/requiredText"},
        "comparison_window": {"$ref": "#/$defs/requiredText"},
        "source": {"$ref": "#/$defs/requiredText"}
      }
    },
    "referenceRanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sources"],
      "properties": {
        "status": {"enum": ["permitted", "unavailable"]},
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requiredText"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "permitted"}}, "required": ["status"]},
          "then": {"properties": {"sources": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]},
          "then": {"properties": {"sources": {"maxItems": 0}}}
        }
      ]
    },
    "thresholdBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "baseline",
        "comparison_window",
        "threshold",
        "unit",
        "source",
        "ad_id"
      ],
      "properties": {
        "metric": {"$ref": "#/$defs/requiredText"},
        "baseline": {"type": "number"},
        "comparison_window": {"$ref": "#/$defs/requiredText"},
        "threshold": {"type": "number"},
        "unit": {"$ref": "#/$defs/requiredText"},
        "source": {"$ref": "#/$defs/requiredText"},
        "ad_id": {"$ref": "#/$defs/nullableText"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requiredText"}
        },
        "date_range": {"$ref": "#/$defs/dateRange"},
        "attribution": {"$ref": "#/$defs/requiredText"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "aggregation_level": {"enum": ["ad"]},
        "field_mapping": {"$ref": "#/$defs/fieldMapping"},
        "ad_mapping": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/requiredText"},
          "additionalProperties": {"$ref": "#/$defs/requiredText"}
        },
        "logged_interventions": {
          "type": "array",
          "items": {"$ref": "#/$defs/intervention"}
        },
        "account_norms": {
          "type": "array",
          "items": {"$ref": "#/$defs/accountNorm"}
        },
        "reference_ranges": {"$ref": "#/$defs/referenceRanges"},
        "threshold_basis": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/thresholdBasis"}
        }
      }
    },
    "performanceDiagnosis": {
      "allOf": [
        {"$ref": "#/$defs/performance"},
        {
          "properties": {
            "source_ids": {"minItems": 1},
            "date_range": {"required": ["start", "end"]},
            "field_mapping": {
              "required": ["ad_id", "spend", "purchases"]
            },
            "ad_mapping": {"minProperties": 1}
          },
          "required": [
            "source_ids",
            "date_range",
            "attribution",
            "currency",
            "aggregation_level",
            "field_mapping",
            "ad_mapping",
            "logged_interventions",
            "account_norms",
            "reference_ranges",
            "threshold_basis"
          ]
        }
      ]
    }
  }
}
